# GitHub token used to authenticate API requests and avoid rate limits.
# Create a token at https://github.com/settings/tokens
GITHUB_TOKEN=

# PCGamingWiki credentials, needed because anonymous Cargo queries are rejected.
# Create a bot password at https://www.pcgamingwiki.com/wiki/Special:BotPasswords,
# then set the username to the bot login (e.g. "Account@Bot") and the password
# to the generated password.
PCGAMINGWIKI_USERNAME=
PCGAMINGWIKI_PASSWORD=
